.gitignore
.dockerignore
.env
.env.*
!/.env.example
secrets*
secrets/**
config.override.*
*.override.yaml
*.override.yml
*.private.yaml
*.private.yml
**/.DS_Store
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/node_modules
**/dist
**/build
**/tmp
**/.venv
**/venv


